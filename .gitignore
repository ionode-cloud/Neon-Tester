# ─── Node modules ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Environment variables (NEVER commit secrets) ─────────────────────────────
.env
.env.local
.env.*.local
# Backend env
backend/.env
# Frontend env (keep .env.example)
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ─── Build outputs ────────────────────────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/
frontend/build/

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Vite cache ───────────────────────────────────────────────────────────────
frontend/.vite/

# ─── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.swp

# ─── Testing / Coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/
